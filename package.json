{
  "name": "dsh-codex-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "把 DSH 侧栏换成 Codex 风格：按日期排列的会话列表 + 铃铛开关 + 官方设置页里的一页设置。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "codex"
  ],
  "license": "MIT"
}
