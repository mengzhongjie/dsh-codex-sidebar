{
  "name": "dsh-codex-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 侧栏的消息视图：全部会话按优先级/昨天/星期X/更早分段，两行式会话行（标题 + 最新消息预览），顶行铃铛切换。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "sidebar",
    "codex"
  ],
  "license": "MIT",
  "icon": "./assets/icon.svg"
}
